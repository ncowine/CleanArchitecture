<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A legacy WPF app: .NET Framework 4.7.2, Prism, and the legacy adapter (Common.RabbitMQ) with plain PubSubEvent<T>
    events (Poc.Legacy.Events). Set up exactly as docs/messaging/README.md recipe A tells an existing legacy app to.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poc.Shared\Poc.Shared.csproj" />
    <ProjectReference Include="..\Poc.Legacy.Events\Poc.Legacy.Events.csproj" />
    <ProjectReference Include="..\..\..\src\Common.RabbitMQ\Common.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
