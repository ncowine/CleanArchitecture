<Project Sdk="Microsoft.NET.Sdk">

  <!--
    POC 3: a modern (.NET 8) WPF app that gets live updates from the API over SignalR, and makes changes through the
    API over HTTP. No RabbitMQ, no broker account, no messaging library: one SignalR package and HttpClient.
    Runs against the real CleanArch.Api; the README in this folder says how to start it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
