<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A modern WPF app: .NET 10, no Prism, the modern event format ([Message] classes, Messaging.Hosting). It accepts
    events from the API only, over RabbitMQ or SignalR (Events:Transport in appsettings.json), and changes data through
    the API over HTTP. It never publishes.

    Note what it does NOT reference: Common.RabbitMQ or Poc.Legacy.Events. It can't even name a legacy app's event.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poc.Shared\Poc.Shared.csproj" />
    <ProjectReference Include="..\..\..\src\Messaging\Messaging.Hosting\Messaging.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
