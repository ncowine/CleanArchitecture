<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A new WPF app: .NET 10 and the Generic Host. It accepts events from the API, over RabbitMQ or SignalR
    (Events:Transport in appsettings.json), and changes data through the API over HTTP. It never publishes.
    A desktop app reaches RabbitMQ through the legacy adapter (Common.RabbitMQ) and its RemotePubSubEvent<T> classes
    (Poc.Legacy.Events), as the net472 and net8 apps do; Messaging.Hosting is for the API only. Over RabbitMQ it also
    receives the ten POC shape events from the legacy apps. SignalR is where desktop apps are heading.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poc.Shared\Poc.Shared.csproj" />
    <ProjectReference Include="..\Poc.Legacy.Events\Poc.Legacy.Events.csproj" />
    <ProjectReference Include="..\..\..\src\Common.RabbitMQ\Common.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
