{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Messaging.RabbitMQ": "Information"
    }
  },
  "Api": {
    "BaseUrl": "http://localhost:5235/",
    "ApiKey": "dev-api-key-integration",
    "Actor": "poc-net10"
  },
  // How the API's events arrive: "RabbitMQ" or "SignalR" (the API's hub). Both right after the API's commit, and the
  // same Equipment.Messages classes either way. The POC shape events come over RabbitMQ only. Override per window: Poc.Net10.exe --Events:Transport=SignalR
  "Events": {
    "Transport": "RabbitMQ"
  },
  "Messaging": {
    "DefaultBus": "Main",
    "Buses": {
      "Main": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "Poc.Net10",
        "ClientName": "Poc.Net10",
        // The API's exchange, plus the legacy apps' exchanges for the POC shape events ONLY: the routing-key pattern
        // keeps their other events (notes, disposals, flags) out.
        "Subscriptions": [
          { "Exchange": "CleanArch" },
          { "Exchange": "Poc.Net472" },
          { "Exchange": "Poc.Net8" }
        ]
      }
    }
  }
}
