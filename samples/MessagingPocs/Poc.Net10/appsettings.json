{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Api": {
    "BaseUrl": "http://localhost:5235/",
    "ApiKey": "dev-api-key-integration",
    "Actor": "poc-net10"
  },
  // How the API's events arrive: "RabbitMQ" (the API's outbox, ~2 s after a change) or "SignalR" (the API's hub, at
  // once). The same Equipment.Messages classes either way. Override per window: Poc.Net10.exe --Events:Transport=SignalR
  "Events": {
    "Transport": "RabbitMQ"
  },
  "Messaging": {
    "Buses": {
      "Main": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "Poc.Net10",
        "ClientName": "Poc.Net10",
        // The API's exchange and nothing else: this is what keeps the legacy apps' events out.
        "Subscriptions": [
          { "Exchange": "CleanArch" }
        ]
      }
    }
  }
}
