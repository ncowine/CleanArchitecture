{
  "Urls": "http://localhost:5240",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Messaging": {
    "DefaultBus": "Main",
    "Buses": {
      "Main": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        // The real API's exchange, so the POC windows that bind it receive these events with no change. A real
        // service would use its own exchange name here, and its receivers would bind that.
        "ExchangeName": "CleanArch",
        "ClientName": "Poc.Api.NoOutbox",
        // One durable queue shared by every instance of this API, with retries and a dead-letter queue.
        "QueueMode": "Shared",
        // Other apps' exchanges to receive from, each bound with its name. The net472 app's disposals and flags come with
        // the "equipment" key, bound where they're subscribed (Program.cs, EquipmentDisposedHandler).
        "Subscriptions": [
          { "Exchange": "Poc.Net472" },
          { "Exchange": "Poc.Net8" }
        ]
      }
    }
  }
}
