<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A small API that publishes straight to RabbitMQ and subscribes to events: no outbox, no database, no changes to the
    messaging libraries.
    It references Messaging.Hosting (the same library the real API uses) and Equipment.Messages (the same events).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Messaging\Messaging.Hosting\Messaging.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Equipment\Equipment.Messages\Equipment.Messages.csproj" />
  </ItemGroup>

</Project>
