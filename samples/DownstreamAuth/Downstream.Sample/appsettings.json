{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",

  // DEVELOPMENT-ONLY demo values. Every secret below is published on purpose — this process stands in for an
  // identity provider and four downstream services on a developer machine, and the CleanArch API's
  // "downstream-demo" launch profile holds the matching values. Never reuse any of them anywhere real.

  // The identity provider. The CleanArch API uses it through the SAME keys it would use for Okta:
  // Okta:Authority = Issuer, OnBehalfOf:TokenEndpoint = Issuer + /connect/token.
  "DevIdp": {
    "Issuer": "https://localhost:7300",
    "TokenLifetimeMinutes": 10,
    // The audience of the user tokens from /dev/token — i.e. the CleanArch API itself (its Okta:Audience).
    "UserTokenAudience": "cleanarch-api",
    // Confidential clients allowed at /connect/token, and the downstream audiences each may ask for.
    "Clients": {
      "cleanarch-api": {
        "Secret": "dev-only-cleanarch-secret",
        "Audiences": [ "api://billing", "api://inventory" ]
      }
    }
  },

  // The downstream services, each accepting exactly ONE kind of credential.
  "Downstreams": {
    // Bearer tokens minted FOR them (On-Behalf-Of / client credentials).
    "billing": { "Audience": "api://billing" },
    "inventory": { "Audience": "api://inventory" },
    // A service in the same trust boundary that deliberately accepts the CleanArch API's OWN audience —
    // the only kind of downstream the caller's token may be forwarded to unchanged.
    "reports": { "Audience": "cleanarch-api" },
    // Legacy credentials.
    "legacy": { "Username": "svc-cleanarch", "Password": "dev-only-legacy-password" },
    "vendor": { "ApiKeyHeader": "X-Vendor-Key", "ApiKey": "dev-only-vendor-key", "KeyOwner": "cleanarch-api" }
  }
}
