# Keeps the Docker build context small and the image clean. Everything listed here is either
# regenerated during the build, unrelated to the API, or huge (the ELK stack's node_modules).
# Do NOT ignore src/, BuildingBlocks*, Modules/, or the root Directory.*.props / global.json —
# the build needs them.

# Build outputs (restored/rebuilt inside the image)
**/bin/
**/obj/

# Git + IDE metadata
.git/
.gitattributes
.vs/
.github/
.claude/

# The ELK dev stack — hundreds of MB of bundled node_modules, nothing the API build touches.
elk/
**/node_modules/

# Downloaded observability binaries + local runtime data (not part of the API build).
observability/**/*.exe
observability/**/tempo-data/
observability/**/loki-data/
observability/prometheus/data/

# Not part of the API image
clients/
tests/
docs/

# Local SQLite files that may exist on the host (the container makes its own under /app/data)
**/*.db
**/*.db-shm
**/*.db-wal
