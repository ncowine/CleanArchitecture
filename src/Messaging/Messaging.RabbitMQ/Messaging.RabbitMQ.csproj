<Project Sdk="Microsoft.NET.Sdk">

  <!-- The transport core. Depends on RabbitMQ.Client, the logging abstractions and System.Text.Json only (ADR 0001, sections 1 and 7). -->
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <!-- The one serializer (SystemTextJsonMessageSerializer). Part of the framework on net8. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Messaging.Abstractions\Messaging.Abstractions.csproj" />
  </ItemGroup>

  <!-- BusSelection: the one rule for which bus binds a routing key, shared by both front doors. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Messaging.Hosting" />
    <InternalsVisibleTo Include="Common.RabbitMQ" />
  </ItemGroup>

</Project>
