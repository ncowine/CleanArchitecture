<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Server hosting for the core: DI, options, keyed buses, routing, IMessagePublisher/IMessageSubscriber and System.Text.Json
    (ADR 0001, section 1). Never loaded by legacy apps. Microsoft.Extensions 8.0 so a net8 client
    can opt in without being forced up.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
  </ItemGroup>

  <!-- Apps add buses only from configuration; the tests add them by hand. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Common.RabbitMQ.Tests" />
  </ItemGroup>

</Project>
