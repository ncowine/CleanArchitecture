{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // RabbitMQ for integration events (docs/messaging/adr/0003). Needs a local broker (tutorials/67 §8).
  // Remove this section to run without one: the API then records no integration events, as before.
  "Messaging": {
    "Buses": {
      "Main": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "CleanArch",
        "ClientName": "CleanArch.Api",
        "QueueMode": "Shared"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:5173" ]
  }
}
