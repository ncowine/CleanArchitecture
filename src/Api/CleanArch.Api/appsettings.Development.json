{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // RabbitMQ for integration events, published after each commit. Needs a local broker (tutorials/67 §8).
  // Remove this section to run without one: the API then drops its integration events.
  "Messaging": {
    "DefaultBus": "Main",
    "Buses": {
      "Main": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "CleanArch",
        "ClientName": "CleanArch.Api",
        "QueueMode": "Shared",
        // Other apps' exchanges, each bound with its name (the key used when the publisher sets none). EquipmentDisposed
        // from the net472 POC comes with the "equipment" key, which its handler binds with [RoutingKey].
        "Subscriptions": [
          { "Exchange": "Poc.Net472" }
        ]
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:5173" ]
  }
}
