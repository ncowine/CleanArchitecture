# =============================================================================
#  Production settings for the Ubuntu observability VM
# =============================================================================
# Copy to ".env" IN THIS FOLDER, fill it in, then lock it down:
#
#     cp .env.example .env && chmod 600 .env
#
# Compose reads ".env" automatically and substitutes ${NAME} in the prod compose
# files. ".env" is git-ignored — never commit it, never paste it into a ticket.
#
# NOTE: this file configures the UBUNTU VM only. The application's own settings
# live on the Windows/IIS server and are covered in README-windows-iis.md.
# A few values have to match on both sides; those are marked "SHARED".
#
# HONEST LIMITATION: values here are visible in `docker inspect` and in each
# container's environment, so anything that can reach the Docker socket can read
# them. Acceptable on a single VM where root already owns everything. The
# upgrade path is Docker secrets or a secret manager; the compose files change,
# nothing else does.
#
# Generate every password and key with real entropy:
#     openssl rand -base64 32
# =============================================================================

# ── Public hostnames ─────────────────────────────────────────────────────────
# All four must have DNS A/AAAA records pointing at THIS VM before the first
# start — Caddy proves domain ownership over port 80 to get certificates, and
# that fails if DNS does not resolve here yet.
#
# The ingest names are genuinely public because the Windows server dials them
# from the internet. The dashboard names are public only so they can hold real
# certificates; Caddy refuses to serve them to anyone outside UI_ALLOWED_IPS.

# Traces + logs ingest.   SHARED: the app points Observability__*__OtlpEndpoint here.
INGEST_HOST=otlp.example.com
# Audit ingest.           SHARED: the app points Audit__Elasticsearch__Uri here.
AUDIT_HOST=audit.example.com
# Dashboards.
GRAFANA_HOST=grafana.example.com
KIBANA_HOST=kibana.example.com

# Where Let's Encrypt sends expiry and problem notices. A real, monitored mailbox.
ACME_EMAIL=ops@example.com

# ── Source-address allowlists ────────────────────────────────────────────────
# Space-separated IPs or CIDR ranges. Caddy returns 403 to everything else
# before the request reaches the service behind it.

# The PUBLIC IP of the Windows/IIS server — the only machine allowed to push
# telemetry. If that server sits behind NAT, use the NAT gateway's address, not
# the server's private one.
#
# ⚠️  If this address is dynamic, ingest breaks silently the next time it
#     changes: the app's pushes start getting 403s, and telemetry just stops
#     arriving. Use a static IP, or plan to update this value.
APP_SERVER_IPS=203.0.113.10

# Where you browse Grafana and Kibana from — your office range, VPN pool, or
# home IP. Add several separated by spaces, e.g. "198.51.100.0/24 203.0.113.55".
# Getting this wrong locks you out of the dashboards, not out of the server, so
# it is recoverable over SSH.
UI_ALLOWED_IPS=198.51.100.0/24

# ── Telemetry ingest credentials ─────────────────────────────────────────────
# Tempo and Loki have no authentication of their own, so this is the credential
# that protects them. Caddy checks it before forwarding.
#
# INGEST_PASSWORD_HASH is a bcrypt hash, not the password. Generate it with:
#     docker run --rm caddy:2.9-alpine caddy hash-password --plaintext 'your-password'
#
# SHARED: the app sends the matching plaintext as a Basic auth header. Build it
# with:  printf 'telemetry-writer:your-password' | base64
# then set on the Windows server:
#     Observability__Tempo__Headers = Authorization=Basic <that base64>
#     Observability__Loki__Headers  = Authorization=Basic <that base64>
INGEST_USER=telemetry-writer
INGEST_PASSWORD_HASH=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Retention (how long telemetry is kept before deletion) ───────────────────
# These exist to stop the disk filling up. Unbounded retention is the most
# common way a self-hosted observability stack takes a server down.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# ── Elasticsearch / Kibana (only used by docker-compose.prod.elk.yml) ────────
# ELASTIC_PASSWORD bootstraps the built-in "elastic" superuser on the FIRST start
# of a fresh volume; changing it later has no effect (use elasticsearch-reset-password).
ELASTIC_PASSWORD=
# Set on the built-in kibana_system account by scripts/bootstrap-elk.sh.
KIBANA_SYSTEM_PASSWORD=
# 32+ chars. If Kibana generates this itself it changes on every restart and you
# silently lose saved objects, alerts and reports.
KIBANA_ENCRYPTION_KEY=

# NOTE: there is no AUDIT_ES_API_KEY here any more. scripts/bootstrap-elk.sh
# still mints that key, but it is consumed by the APP on the Windows server
# (Audit__Elasticsearch__ApiKey), not by anything in this compose stack.
