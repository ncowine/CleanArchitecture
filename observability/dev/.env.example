# =============================================================================
#  Development stack settings — copy to ".env" in this folder
# =============================================================================
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#
# Compose reads ".env" automatically. Nothing here is secret: the dev stack has
# no passwords, and it only listens on loopback. The production equivalent is
# ../prod/.env.example.
# =============================================================================

# ── Image versions ───────────────────────────────────────────────────────────
# Pinned, not "latest", so a rebuild does not silently change the stack.
TEMPO_VERSION=2.7.1
LOKI_VERSION=3.4.2
PROMETHEUS_VERSION=v3.1.0
GRAFANA_VERSION=11.5.1
# Must match the app's Elastic client major version (9.x).
ELASTIC_VERSION=9.4.4

# ── Where the ports are published ────────────────────────────────────────────
# 127.0.0.1 = this machine only. Use 0.0.0.0 to let a colleague or a VM reach
# your dev stack — remember there is no authentication on any of it.
BIND_ADDR=127.0.0.1

# ── Elasticsearch heap (only used by the "elk" profile) ──────────────────────
# ES reserves this up front. 512m is enough for a dev audit trail.
ES_HEAP=512m
