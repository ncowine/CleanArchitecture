# =============================================================================
#  Development stack settings — copy to ".env" in this folder
# =============================================================================
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#
# Compose reads ".env" automatically. Nothing here is secret: the dev stack has
# no passwords, and it only listens on loopback. The production equivalent is
# ../prod/.env.example.
# =============================================================================

# ── Image versions ───────────────────────────────────────────────────────────
# Pinned, not "latest", so a rebuild does not silently change the stack.
TEMPO_VERSION=2.7.1
LOKI_VERSION=3.4.2
# 3.4 is the floor: prometheus.yml sets metric_name_escaping_scheme, which older
# builds reject as an unknown key and then refuse to start.
PROMETHEUS_VERSION=v3.5.5
GRAFANA_VERSION=11.5.1
# Must match the app's Elastic client major version (9.x).
ELASTIC_VERSION=9.4.4

# ── Where the ports are published ────────────────────────────────────────────
# 127.0.0.1 = this machine only. Use 0.0.0.0 to let a colleague or a VM reach
# your dev stack — remember there is no authentication on any of it.
BIND_ADDR=127.0.0.1

# ── Elasticsearch heap (only used by the "elk" profile) ──────────────────────
# ES reserves this up front. 512m is enough for a dev audit trail.
ES_HEAP=512m

# ── Alert email (optional) ───────────────────────────────────────────────────
# Grafana's SMTP client is OFF unless SMTP_ENABLED is true, so the defaults below
# are inert and the stack starts fine with none of them filled in. Turn it on
# only when you actually want the dev stack to send mail — and remember the alert
# rules notify nobody until you also uncomment a contact point in
# ../grafana/provisioning/alerting/cleanarch-api.yaml.
#
# For local testing prefer a catcher over a real relay: MailHog or Mailpit on
# :1025 accepts anything and shows it in a web UI, so nothing escapes your
# machine. `docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit`, then set
# SMTP_HOST=host.docker.internal:1025 and leave user/password blank.
SMTP_ENABLED=false
# HOST MUST INCLUDE THE PORT. The setting is host:port as a whole (it defaults to
# localhost:25), so a bare "smtp.example.com" is not "port 25 assumed" — it fails
# with an opaque dial error.
SMTP_HOST=host.docker.internal:1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=cleanarch-dev@example.com
SMTP_FROM_NAME=CleanArch Dev
# OpportunisticStartTLS upgrades if the server offers it. Use MandatoryStartTLS
# against a real relay; NoStartTLS only for a local catcher.
SMTP_STARTTLS_POLICY=OpportunisticStartTLS
SMTP_SKIP_VERIFY=false
