# =============================================================================
#  Production stack settings — copy to ".env" on the Docker host
# =============================================================================
#     cp .env.example .env && chmod 600 .env
#
# Compose reads ".env" automatically and substitutes ${NAME} in
# docker-compose.yml. ".env" is git-ignored — never commit it.
#
# The values below are DUMMIES. Replace every password before the first start;
# generate them with:   openssl rand -base64 24
#
# Values marked SHARED must be configured identically on the Windows/IIS server.
# See ../README.md, "Point the app at the stack".
#
# Honest limitation: these values are readable via `docker inspect` by anything
# that can reach the Docker socket. That is acceptable on a single internal VM
# where root already owns everything; the upgrade path is Docker secrets.
# =============================================================================

# ── Image versions ───────────────────────────────────────────────────────────
# Pinned, not "latest", so a `docker compose pull` cannot change the stack under you.
TEMPO_VERSION=2.7.1
LOKI_VERSION=3.4.2
# 3.4 is the floor: prometheus.yml sets metric_name_escaping_scheme, which older
# builds reject as an unknown key and then refuse to start.
PROMETHEUS_VERSION=v3.5.5
GRAFANA_VERSION=11.5.1
# Must match the app's Elastic client major version (9.x).
ELASTIC_VERSION=9.4.4

# ── Network ──────────────────────────────────────────────────────────────────
# The LAN address of THIS Docker host. Every port is published on it, so the IIS
# server and your browser reach the stack here. Do not use 0.0.0.0 unless the
# host has no other interface: Tempo and Loki accept anything that reaches them.
BIND_ADDR=10.20.30.40

# The IIS server, as an IP address (Prometheus scrapes it — it dials out, the
# app does not push metrics). Must be an IP: docker extra_hosts does not resolve
# names. If the site is not on port 5235, change the port in prometheus.yml too.
API_HOST_IP=10.20.30.50

# ── Grafana (dashboards UI) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-grafana-Kd82Lq0Xr4

# ── Elasticsearch / Kibana (audit trail) ─────────────────────────────────────
# The "elastic" superuser. Bootstraps on the FIRST start of an empty es-data
# volume; changing it afterwards needs elasticsearch-reset-password. You log
# into Kibana with this.
ELASTIC_PASSWORD=CHANGE-ME-elastic-7Hs21QpZx4

# Kibana's own service account. Set automatically by the es-setup container.
KIBANA_SYSTEM_PASSWORD=CHANGE-ME-kibanasys-4Rt99Wme2

# 32+ characters, and STABLE. If this changes, Kibana loses saved objects,
# alerts and reports.
KIBANA_ENCRYPTION_KEY=CHANGE-ME-0123456789abcdef0123456789abcdef

# SHARED — the write-only account the app ships audit records as. Created by the
# es-setup container; the same user/password go into Audit__Elasticsearch__* on
# the IIS server.
AUDIT_USER=audit-writer
AUDIT_PASSWORD=CHANGE-ME-audit-2Pl48Vcn6

# Java heap Elasticsearch reserves up front. Roughly half the RAM you are willing
# to give it, and never more than 31g.
ES_HEAP=1g

# ── Alert email ──────────────────────────────────────────────────────────────
# Grafana's SMTP client is off until SMTP_ENABLED is true. Leave it false and the
# alert rules still evaluate and still show as Firing in the UI — they just reach
# nobody. Turning it on is only half the job: also uncomment the email contact
# point and the notification policy at the bottom of
# ../grafana/provisioning/alerting/cleanarch-api.yaml, then restart Grafana.
SMTP_ENABLED=true

# HOST MUST INCLUDE THE PORT. The setting is host:port as a whole (it defaults to
# localhost:25), so a bare "smtp.example.com" is not "port 25 assumed" — it fails
# with an opaque dial error rather than a validation message. 587 = submission
# /STARTTLS, 465 = implicit TLS (use SMTP_STARTTLS_POLICY=NoStartTLS for that one),
# 25 = an internal relay that does not authenticate.
SMTP_HOST=smtp.example.com:587

# Blank both of these for an internal relay that authorises by source IP.
SMTP_USER=alerts@example.com
SMTP_PASSWORD=CHANGE-ME-smtp-9Wq37Zbt5

# The From: header. Many relays reject a domain they are not authoritative for,
# so this usually has to be a real mailbox on your own domain.
SMTP_FROM_ADDRESS=alerts@example.com
SMTP_FROM_NAME=CleanArch Alerts

# OpportunisticStartTLS upgrades if offered and silently continues in the clear if
# not. MandatoryStartTLS refuses to send unencrypted — prefer it over the public
# internet. NoStartTLS is for port 465 (already TLS) or a trusted internal relay.
SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Only true for a relay with a self-signed certificate. It disables certificate
# verification entirely, so it is a downgrade, not a convenience.
SMTP_SKIP_VERIFY=false

# ── Retention ────────────────────────────────────────────────────────────────
# Prometheus deletes whichever limit it hits first. Tempo and Loki keep 30 days,
# set in tempo.yaml and loki.yaml. Unbounded retention is the usual way a
# self-hosted observability stack takes its own host down.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB
