# =============================================================================
#  Broker settings — copy to ".env" in this folder
# =============================================================================
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#
# ".env" is git-ignored: it holds every broker password. Use long random ones
# made of letters and digits only (users.sh puts them in JSON unescaped), e.g.
#     openssl rand -hex 24
#     PowerShell: -join (1..48 | % { '{0:x}' -f (Get-Random -Maximum 16) })
# =============================================================================

# Pinned, not "latest", so a rebuild does not silently change the broker.
RABBITMQ_VERSION=4.3.6
CURL_VERSION=8.11.1

# 127.0.0.1 = this machine only. Use 0.0.0.0 only when other machines must
# connect, and then add TLS first (README.md).
BIND_ADDR=127.0.0.1

# The management UI's administrator. No application connects as this user.
ADMIN_USER=admin
ADMIN_PASSWORD=

# One password per application user in users.sh.
API_PASSWORD=
# LEGACY_APP1_PASSWORD=
