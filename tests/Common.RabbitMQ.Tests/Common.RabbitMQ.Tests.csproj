<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Both builds of Common.RabbitMQ share namespaces; each is referenced directly so the alias applies. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common.RabbitMQ\Common.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\src\Messaging\Messaging.Abstractions\Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Messaging\Messaging.RabbitMQ\Messaging.RabbitMQ.csproj" />
    <ProjectReference Include="..\Fixtures\Common.Events\Common.Events.csproj" />
    <ProjectReference Include="..\..\src\Common.RabbitMQ.Configuration\Common.RabbitMQ.Configuration.csproj" />
    <ProjectReference Include="..\Fixtures\Compat.Events\Compat.Events.csproj" />
    <ProjectReference Include="..\Fixtures\Common.RabbitMQ.Baseline\Common.RabbitMQ.Baseline.csproj" Aliases="baseline" />
    <ProjectReference Include="..\Fixtures\Compat.Events.Baseline\Compat.Events.Baseline.csproj" Aliases="baseline" />
  </ItemGroup>

  <!-- Model of the real legacy library and its event assemblies (ADR 0002, step 5). -->
  <ItemGroup>
    <ProjectReference Include="..\Fixtures\LegacyModel\Legacy.RabbitMQ\Legacy.RabbitMQ.csproj" />
    <ProjectReference Include="..\Fixtures\LegacyModel\AppA.Events\AppA.Events.csproj" />
    <ProjectReference Include="..\Fixtures\LegacyModel\AppB.Events\AppB.Events.csproj" />
    <ProjectReference Include="..\Fixtures\LegacyModel\Shared.Events\Shared.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Messaging.Hosting is the server's (net8.0+); its tests don't exist in the net472 build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <ProjectReference Include="..\..\src\Messaging\Messaging.Hosting\Messaging.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Messaging\Messaging.Prism\Messaging.Prism.csproj" />
    <ProjectReference Include="..\Fixtures\Employees.Contracts\Employees.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <Compile Remove="Hosting\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

</Project>
